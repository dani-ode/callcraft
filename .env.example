# General Environment Settings
APP_ENV=production
PORT=8080

# PostgreSQL Credentials (Used by Docker Compose & API)
POSTGRES_DB=callcraft_db
POSTGRES_USER=callcraft_user
POSTGRES_PASSWORD=secret_password

# Redis Credentials (Used by Docker Compose & API)
REDIS_PASSWORD=redis_password

# Platform Security & Encryption Keys (Must be 64 hex characters)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SERVICE_CLIENT_ID=svc_nextjs_main
SERVICE_CLIENT_SECRET=sec_live_default_nextjs_service_secret_key_12345

# Next.js Web Frontend & Public Domain Settings
NEXT_PUBLIC_API_URL=https://callcraft-api.daniode.com
NEXTAUTH_URL=https://callcraft.daniode.com
NEXTAUTH_SECRET=supersecret_nextauth_session_key_9988776655

# WebMail SMTP Credentials (Optional for Email Notifications)
MAIL_MAILER=smtp
MAIL_HOST=flyup.id
MAIL_PORT=465
MAIL_USERNAME=callcraft@flyup.id
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=callcraft@flyup.id
MAIL_FROM_NAME="CallCraft"
