# General Environment Settings
APP_NAME="CallCraft"
APP_ENV=production
PORT=8080
WEB_PORT=3000

# PostgreSQL Configuration
POSTGRES_DB=callcraft_db
POSTGRES_USER=callcraft_user
POSTGRES_PASSWORD=secret_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Platform Security & Encryption Keys (64 hex characters)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SERVICE_CLIENT_ID=svc_nextjs_main
SERVICE_CLIENT_SECRET=sec_live_default_nextjs_service_secret_key_12345

# Initial Platform Admin Superuser Credentials
ADMIN_EMAIL=dev@callcraft.io
ADMIN_PASSWORD=callcraft_admin_secret_123
ADMIN_NAME="Callcraft Admin"

# Experiential OpenAI-Compatible Gateway
# Required exclusively when using model claude-fable-5.1. Create this under Settings -> API keys.
EXPLABS_API_KEY=

# Next.js Web Frontend & Public Domain Settings
NEXT_PUBLIC_API_URL=http://127.0.0.1:8081
FRONTEND_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=supersecret_nextauth_session_key_9988776655

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/internal/v1/auth/google/callback

# WebMail SMTP Credentials
MAIL_MAILER=smtp
MAIL_HOST=flyup.id
MAIL_PORT=465
MAIL_USERNAME=callcraft@flyup.id
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="callcraft@flyup.id"
MAIL_FROM_NAME="CallCraft"
