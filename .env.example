# General Environment Settings
APP_ENV=development
PORT=8080

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://ocr_user:secret_password@127.0.0.1:5432/ocr_platform

# Redis Configuration (Redis 7)
REDIS_URL=redis://:redis_password@127.0.0.1:6379

# Platform Security & Encryption Keys
# Must be a 32-byte hex string (64 characters) for AES-256-GCM
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service Auth Credentials (Next.js -> Rust Internal Auth)
SERVICE_CLIENT_ID=svc_nextjs_main
SERVICE_CLIENT_SECRET=sec_live_default_nextjs_service_secret_key_12345

# Next.js Auth Secret
NEXTAUTH_SECRET=supersecret_nextauth_session_key_9988776655
NEXTAUTH_URL=http://localhost:3000

# Web Next.js Internal API Gateway Target
INTERNAL_RUST_API_URL=http://127.0.0.1:8080/internal/v1
