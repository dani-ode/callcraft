          },
          {
            "node": "Step 3: Execute Call Spec (POST /v1/call)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 1: Get List of Projects": {
      "main": [
        [
          {
            "node": "Step 2: Get List of Specs by Project",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
